#!/bin/bash
set -euxo pipefail

# Instalar Docker
yum update -y
yum install -y docker
systemctl start docker
systemctl enable docker
usermod -aG docker ec2-user

# Instalar Docker Compose
curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose

# Montar EFS
mkdir -p /mnt/efs
echo "${efs_id}.efs.${region}.amazonaws.com:/ /mnt/efs nfs4 nfsvers=4.1,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2,noresvport,_netdev 0 0" >> /etc/fstab
mount -a

# Permisos para EFS
chown 999:999 /mnt/efs
chmod 750 /mnt/efs

# Crear carpeta para el despliegue
mkdir -p /home/ec2-user/cloudnative
chown ec2-user:ec2-user /home/ec2-user/cloudnative